		# ====== SECTION A — ANDESITE MASTERY (Q1-Q5) ======

		# ---------- Q01: Scene-beat opener — The Apprentice Returns ----------
		{
			id: "5A11E0F1B0010001"
			x: 0.0d
			y: 0.0d
			shape: "diamond"
			size: 1.5d
			title: "The Apprentice Returns to Their Bench"
			subtitle: "Erik hands you a copper-trimmed cap. The Tinker's Bench docket."
			description: [
				"Erik catches you in the workshop after Smoke Rises. \"Foreman, the Charter trains administrators. But it also trains mechanics. There's a different ladder if you want it.\""
				""
				"He hands you a copper-trimmed Engineer's Cap and a thinner docket: the Tinker's Bench. Optional. The Charter doesn't audit it. But the senior mechanics know each other by the cap."
				""
				"Hold four Precision Mechanisms to signal you're ready for Sequenced Assembly."
			]
			icon: "create:goggles"
			tasks: [{
				id: "5A11E0F1B0020001"
				type: "item"
				item: { Count: 1b, id: "create:precision_mechanism" }
				count: 4L
			}]
			rewards: [
				{ id: "5A11E0F1B0030001", type: "xp", xp: 60 }
				{ id: "5A11E0F1B0030002", type: "item", item: { id: "create:precision_mechanism", Count: 4b } }
			]
			dependencies: ["5A11E0F102010040"]
		}

		# ---------- Q02: Sequenced Assembly (mechanical milestone) ----------
		{
			id: "5A11E0F1B0010002"
			x: 0.0d
			y: 2.0d
			shape: "rsquare"
			title: "Sequenced Assembly"
			subtitle: "Deployer + Press + Mixer on a belt. Iron + andesite alloy in, Precision Mechanism out."
			description: [
				"The Charter's most-celebrated Create technique: a belt running under a Deployer (adding andesite), a Press (flattening), and a Mixer (refining). The item exits as a fully-formed Precision Mechanism without your hand touching it."
				""
				"Set it up. Auto-craft eight Precision Mechanisms via Sequenced Assembly. The hand-crafted four don't count — the Charter records only what the belt produces."
			]
			icon: "create:precision_mechanism"
			tasks: [{
				id: "5A11E0F1B0020002"
				type: "checkmark"
				title: "Build a Sequenced Assembly line and produce 8+ Precision Mechanisms from it"
			}]
			rewards: [
				{ id: "5A11E0F1B0030003", type: "xp", xp: 100 }
				{ id: "5A11E0F1B0030004", type: "item", item: { id: "create:precision_mechanism", Count: 8b } }
			]
			dependencies: ["5A11E0F1B0010001"]
		}

